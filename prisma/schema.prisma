// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User Authentication and Profile
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String?
  firstName     String
  lastName      String
  name          String?  // Computed field
  avatar        String?
  bio           String?
  phone         String?
  location      String?
  website       String?
  linkedin      String?
  twitter       String?
  instagram     String?
  dateOfBirth   DateTime?
  gender        String?  // For women-focused platform
  businessStage String?  // idea, startup, growth, established
  industry      String?
  skills        String?  // JSON array of skills
  interests     String?  // JSON array of interests
  role          String   @default("entrepreneur") // entrepreneur, mentor, investor, admin
  isActive      Boolean  @default(true)
  isVerified    Boolean  @default(false)
  emailVerifiedAt DateTime?
  passwordResetToken String?
  passwordResetExpires DateTime?
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  twoFactorBackupCodes String?  // JSON array of backup codes
  lastLoginAt       DateTime?
  provider         String?  // google, linkedin, etc.
  providerId       String?  // OAuth provider user ID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  businessProfile   BusinessProfile?
  courses           CourseEnrollment[]
  mentorshipsAsMentor Mentorship[] @relation("Mentor")
  mentorshipsAsMentee Mentorship[] @relation("Mentee")
  mentorProfile     MentorProfile?
  mentorAvailability MentorAvailability[]
  sessionReviewsAsReviewer SessionReview[] @relation("SessionReviewer")
  sessionReviewsAsReviewee SessionReview[] @relation("SessionReviewee")
  investments       Investment[]
  fundingRequests   FundingRequest[]
  communityPosts    CommunityPost[]
  communityComments CommunityComment[]
  events            EventAttendance[]
  products          Product[]
  orders            Order[]
  aiConversations   AIConversation[]
  tasks             Task[]
  certificates      Certificate[]
  quizAttempts      QuizAttempt[]
  lessonProgress    LessonProgress[]
  referralsAsReferrer Referral[] @relation("Referrer")
  referralsAsReferred Referral[] @relation("Referred")
  affiliateEarnings AffiliateEarning[]
  coursesAsInstructor Course[] @relation("Instructor")
  courseReviews     CourseReview[] @relation("CourseReview")
  organizedEvents   Event[] @relation("Organizer")
  productReviews    ProductReview[] @relation("ProductReview")
  sessions          UserSession[]
  emailVerificationToken EmailVerificationToken?
  grantApplications GrantApplication[]
  notifications Notification[]
  refundsAsRequester Refund[] @relation("RefundRequester")
  refundsAsApprover Refund[] @relation("RefundApprover")
  refundsAsRejector Refund[] @relation("RefundRejector")
  subscriptions Subscription[]
  invoices Invoice[]
  paymentMethods PaymentMethod[]
  businessMetrics BusinessMetric[]
  customerAnalytics CustomerAnalytics[]
  salesReports SalesReport[]
  growthTracking GrowthTracking[]
  customReports CustomReport[]
  userProfile UserProfile?
  connectionsAsRequester Connection[] @relation("ConnectionRequester")
  connectionsAsRecipient Connection[] @relation("ConnectionRecipient")
  messagesAsSender Message[] @relation("MessageSender")
  messagesAsRecipient Message[] @relation("MessageRecipient")
  createdGroups CommunityGroup[] @relation("GroupCreator")
  groupMemberships GroupMember[]
  networkingMatchesAsUser NetworkingMatch[] @relation("NetworkingMatchUser")
  networkingMatchesAsMatched NetworkingMatch[] @relation("NetworkingMatchMatchedUser")
  userChecklistProgress UserChecklistProgress[]
  legalConsultations LegalConsultation[]
  contracts Contract[]
  intellectualProperties IntellectualProperty[]
  blogPosts      BlogPost[]
  blogComments   BlogComment[]
  resources      Resource[]
  newsletters    Newsletter[]
  mediaFiles     MediaFile[]
  contentSchedules ContentSchedule[]
  auditLogs      AuditLog[]
  userRoles      UserRole[]

  @@map("users")
}

// Password Reset Tokens
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

// Email Verification Tokens
model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId])
  @@map("email_verification_tokens")
}

// User Sessions
model UserSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  deviceInfo String?
  ipAddress  String?
  userAgent  String?
  expiresAt DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("user_sessions")
}

// Business Profile
model BusinessProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  businessName     String
  businessEmail    String?
  businessPhone    String?
  businessAddress  String?
  businessWebsite  String?
  businessLogo     String?
  businessType     String?  // sole-proprietorship, llc, corporation, etc.
  industry         String
  description      String?
  mission          String?
  vision           String?
  foundedDate      DateTime?
  employeeCount    Int?
  annualRevenue    Float?
  targetMarket     String?
  businessPlan     String?  // URL to business plan document
  isRegistered     Boolean  @default(false)
  registrationDate DateTime?
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("business_profiles")
}

// Mentor Profile
model MentorProfile {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  expertise       String?  // JSON array of areas of expertise
  experience      Int      // Years of experience
  company         String?
  position        String?
  education       String?
  certifications  String?  // JSON array of certifications
  bio             String?
  hourlyRate      Float?
  availability    String?  // available, busy, unavailable
  mentorshipType  String?  // JSON array of mentorship types
  isVerified      Boolean  @default(false)
  rating          Float    @default(0)
  reviewCount     Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("mentor_profiles")
}

// Courses and Learning
model Course {
  id            String   @id @default(cuid())
  title         String
  description   String
  category      String   // business, marketing, finance, leadership, etc.
  level         String   // beginner, intermediate, advanced
  duration      Int      // Duration in hours
  price         Float?
  thumbnail     String?
  instructorId  String
  instructor    User     @relation("Instructor", fields: [instructorId], references: [id])
  
  isPublished   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  enrollmentCount Int     @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  lessons       Lesson[]
  enrollments   CourseEnrollment[]
  reviews       CourseReview[]
  certificates  Certificate[]

  @@map("courses")
}

model Lesson {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  title       String
  content     String
  videoUrl    String?
  duration    Int      // Duration in minutes
  order       Int
  isPreview   Boolean  @default(false)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  quizzes     Quiz[]
  progress    LessonProgress[]

  @@map("lessons")
}

model Quiz {
  id          String   @id @default(cuid())
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  title       String
  description String?
  timeLimit   Int?     // Time limit in minutes
  passingScore Float   @default(0.7) // 70% passing score
  isRequired  Boolean  @default(false)
  order       Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  questions   Question[]
  attempts    QuizAttempt[]

  @@map("quizzes")
}

model Question {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  
  question    String
  type        String   // multiple-choice, true-false, short-answer, essay
  options     String?  // JSON array of options for multiple choice
  correctAnswer String?
  points      Int      @default(1)
  order       Int
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  answers     Answer[]

  @@map("questions")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  score       Float
  maxScore    Float
  isPassed    Boolean
  timeSpent   Int      // Time spent in seconds
  completedAt DateTime
  
  createdAt   DateTime @default(now())

  // Relations
  answers     Answer[]

  @@unique([quizId, userId])
  @@map("quiz_attempts")
}

model Answer {
  id          String   @id @default(cuid())
  questionId  String
  question    Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  attemptId   String
  attempt     QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  
  answer      String
  isCorrect   Boolean
  
  createdAt   DateTime @default(now())

  @@map("answers")
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id])
  enrollmentId String
  enrollment  CourseEnrollment @relation(fields: [enrollmentId], references: [id])
  
  isCompleted Boolean  @default(false)
  progress    Float    @default(0) // Progress percentage for this lesson
  timeSpent   Int      @default(0) // Time spent in seconds
  lastWatchedPosition Int? @default(0) // Video position in seconds
  
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, lessonId])
  @@map("lesson_progress")
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  
  progress    Float    @default(0) // Progress percentage
  completedAt DateTime?
  certificateId String?
  
  enrolledAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("CourseReview", fields: [userId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id])
  
  rating    Int      // 1-5 stars
  comment   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("course_reviews")
}

// Mentorship
model Mentorship {
  id            String   @id @default(cuid())
  mentorId      String
  mentor        User     @relation("Mentor", fields: [mentorId], references: [id])
  menteeId      String
  mentee        User     @relation("Mentee", fields: [menteeId], references: [id])
  
  status        String   @default("pending") // pending, accepted, rejected, completed, cancelled
  type          String   // one-on-one, group, coaching
  focusAreas    String?  // JSON array of focus areas
  goals         String?
  duration      Int      // Duration in weeks
  price         Float?
  scheduledAt   DateTime?
  completedAt   DateTime?
  paymentId     String?  // Reference to payment
  paymentStatus String?  // pending, succeeded, failed, refunded
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  sessions      MentorshipSession[]

  @@unique([mentorId, menteeId])
  @@map("mentorships")
}

// Mentorship Sessions
model MentorshipSession {
  id            String   @id @default(cuid())
  mentorshipId  String
  mentorship    Mentorship @relation(fields: [mentorshipId], references: [id], onDelete: Cascade)
  
  title         String?
  description   String?
  startTime     DateTime
  endTime       DateTime
  status        String   @default("scheduled") // scheduled, in-progress, completed, cancelled, no-show
  sessionType   String   @default("one-on-one") // one-on-one, group, workshop
  location      String?  // Physical location or "Online"
  isOnline      Boolean  @default(true)
  meetingUrl    String?  // Video call URL
  meetingId     String?  // Video call meeting ID
  notes         String?  // Session notes or agenda
  recordingUrl  String?  // Session recording URL
  paymentId     String?  // Reference to payment
  paymentStatus String?  // pending, succeeded, failed, refunded
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  reviews       SessionReview[]

  @@map("mentorship_sessions")
}

// Mentor Availability
model MentorAvailability {
  id            String   @id @default(cuid())
  mentorId      String
  mentor        User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  
  dayOfWeek     Int      // 0 = Sunday, 1 = Monday, etc.
  startTime     String   // HH:mm format
  endTime       String   // HH:mm format
  timezone      String   @default("UTC")
  
  isRecurring   Boolean  @default(true)
  recurringUntil DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("mentor_availability")
}

// Session Reviews and Ratings
model SessionReview {
  id            String   @id @default(cuid())
  sessionId     String
  session       MentorshipSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User     @relation("SessionReviewer", fields: [reviewerId], references: [id])
  revieweeId    String
  reviewee      User     @relation("SessionReviewee", fields: [revieweeId], references: [id])
  
  rating        Int      // 1-5 stars
  comment       String?
  anonymous     Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([sessionId, reviewerId])
  @@map("session_reviews")
}

// Video Call Management
model VideoCall {
  id            String   @id @default(cuid())
  meetingId     String   @unique
  meetingUrl    String
  title         String?
  startTime     DateTime
  endTime       DateTime
  status        String   @default("scheduled") // scheduled, in-progress, ended, failed
  provider      String   @default("MockVideoCall")
  password      String?
  record        Boolean  @default(false)
  waitingRoom   Boolean  @default(true)
  recordingUrl  String?
  expiresAt     DateTime?
  endedAt       DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("video_calls")
}

// Payment Management
model Payment {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  amount        Float
  currency      String   @default("USD")
  description   String
  status        String   @default("pending") // pending, succeeded, failed, cancelled, refunded
  provider      String   @default("MockPayment")
  metadata      String?  // JSON metadata
  customerId    String?
  paymentMethod String?  // JSON payment method details
  processedAt   DateTime?
  refundedAt    DateTime?
  refundAmount  Float?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  refunds       Refund[] @relation("RefundPayment")

  @@map("payments")
}

// Funding and Investments
model FundingRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  businessName  String
  description   String
  industry      String
  fundingType   String   // equity, debt, grant, loan
  amount        Float
  valuation     Float?
  equityOffered Float?
  useOfFunds    String?
  businessPlan  String?  // URL to business plan
  pitchDeck     String?  // URL to pitch deck
  
  status        String   @default("draft") // draft, submitted, under-review, approved, rejected, funded
  deadline      DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  investments   Investment[]
  refunds       Refund[] @relation("RefundFundingRequest")

  @@map("funding_requests")
}

model Investment {
  id             String   @id @default(cuid())
  fundingRequestId String
  fundingRequest FundingRequest @relation(fields: [fundingRequestId], references: [id])
  investorId     String
  investor       User     @relation(fields: [investorId], references: [id])
  
  amount         Float
  equity         Float?
  terms          String?
  status         String   @default("proposed") // proposed, accepted, completed, cancelled
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("investments")
}

// Community and Networking
model CommunityPost {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  title     String
  content   String
  category  String?  // discussion, question, announcement, success-story
  tags      String?  // JSON array of tags
  image     String?
  
  likes     Int      @default(0)
  views     Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  comments  CommunityComment[]

  @@map("community_posts")
}

model CommunityComment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  
  content   String
  parentId  String?  // For nested comments
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("community_comments")
}

// Events
model Event {
  id            String   @id @default(cuid())
  title         String
  description   String
  type          String   // webinar, workshop, networking, conference
  category      String   // business, marketing, finance, leadership, etc.
  location      String?  // Physical location or "Online"
  isOnline      Boolean  @default(true)
  maxAttendees  Int?
  price         Float?
  thumbnail     String?
  organizerId   String
  organizer     User     @relation("Organizer", fields: [organizerId], references: [id])
  
  startDate     DateTime
  endDate       DateTime
  isPublished   Boolean  @default(false)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  attendees     EventAttendance[]

  @@map("events")
}

model EventAttendance {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id])
  
  status      String   @default("registered") // registered, attended, cancelled
  feedback    String?
  rating      Int?
  
  registeredAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, eventId])
  @@map("event_attendances")
}

// E-commerce and Marketplace
model Product {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  name          String
  description   String
  category      String
  price         Float
  images        String?  // JSON array of image URLs
  tags          String?  // JSON array of tags
  inventory     Int      @default(0)
  sku           String?
  isDigital     Boolean  @default(false)
  digitalFile   String?  // URL to digital file
  
  isPublished   Boolean  @default(false)
  isFeatured    Boolean  @default(false)
  viewCount     Int      @default(0)
  salesCount    Int      @default(0)
  rating        Float    @default(0)
  reviewCount   Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orderItems    OrderItem[]
  reviews       ProductReview[]

  @@map("products")
}

model ProductReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("ProductReview", fields: [userId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  rating    Int      // 1-5 stars
  comment   String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@map("product_reviews")
}

model Order {
  id            String   @id @default(cuid())
  orderNumber   String?  @unique
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  
  status        String   @default("pending") // pending, processing, shipped, delivered, cancelled
  paymentId     String?
  subtotal      Float    @default(0)
  shipping      Float    @default(0)
  tax           Float    @default(0)
  totalAmount   Float
  shippingAddress String?
  billingAddress  String?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  orderItems    OrderItem[]

  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  quantity  Int
  price     Float    // Price at time of purchase
  
  createdAt DateTime @default(now())

  @@map("order_items")
}

// AI Assistant
model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  
  title     String?
  messages  Json     // Array of conversation messages
  context   String?  // Business context or topic
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ai_conversations")
}

// Task Management
model Task {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  title       String
  description String?
  category    String?  // business, personal, learning, etc.
  priority    String   @default("medium") // low, medium, high
  status      String   @default("pending") // pending, in-progress, completed, cancelled
  dueDate     DateTime?
  completedAt DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tasks")
}

// Certificates
model Certificate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id])
  
  certificateUrl String?
  issuedAt    DateTime @default(now())
  expiresAt   DateTime?
  
  createdAt   DateTime @default(now())

  @@unique([userId, courseId])
  @@map("certificates")
}

// Affiliate and Referral Program
model Referral {
  id          String   @id @default(cuid())
  referrerId  String
  referrer    User     @relation("Referrer", fields: [referrerId], references: [id])
  referredId  String
  referred    User     @relation("Referred", fields: [referredId], references: [id])
  
  status      String   @default("pending") // pending, completed, cancelled
  reward      Float?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([referrerId, referredId])
  @@map("referrals")
}

model AffiliateEarning {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  
  source      String   // course, product, service
  sourceId    String
  amount      Float
  commission  Float
  status      String   @default("pending") // pending, approved, paid
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("affiliate_earnings")
}

// Funding Opportunities
model FundingOpportunity {
  id            String   @id @default(cuid())
  
  title         String
  organization  String
  description   String
  amount        Float
  type          String   // grant, loan, equity, competition
  category      String
  industry      String?
  region        String?
  deadline      DateTime?
  difficulty    String   @default("medium") // low, medium, high
  
  eligibility   String?  // JSON array of eligibility criteria
  requirements  String?  // JSON array of application requirements
  applicationUrl String?
  contactInfo   String?
  
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  viewCount     Int      @default(0)
  applicationCount Int    @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

